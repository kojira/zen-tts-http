<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.kojira.zen-tts-server</string>
  <key>ProgramArguments</key>
  <array>
    <!-- Node.js 26.12.1 or later. Replace with your node path. -->
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/YOU/zen-tts-server/src/main.js</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/YOU/zen-tts-server</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>ZEN_TTS_BIND</key>
    <string>127.0.0.1:50023</string>
    <key>ZEN_TTS_MODELS</key>
    <string>/Users/YOU/Library/Application Support/zen-tts-server/models</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/YOU/Library/Logs/zen-tts-server.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/Library/Logs/zen-tts-server.log</string>
</dict>
</plist>
